{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":enableVulnerabilityAlerts",
    ":gitSignOff",
    ":ignoreModulesAndTests",
    ":prConcurrentLimitNone",
    ":prHourlyLimitNone",
    ":label(dependencies)",
    ":semanticCommits",
    ":semanticCommitType(bump)"
  ],
  "packageRules": [
    {
      "description": "Disable pin digest in docker-compose",
      "matchFileNames": ["docker-compose.yml"],
      "pinDigests": false,
      "matchPackageNames": ["*"]
    },
    {
      "description": "Group all liquidsoap containers versions",
      "matchPackageNames": ["savonet/liquidsoap"],
      "groupName": "liquidsoap"
    },
    {
      "description": "Group GitHub Actions related bumps",
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["/action/"],
      "separateMajorMinor": false
    }
  ]
}
